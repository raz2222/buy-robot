# Copy to .env and fill in. Never commit the real .env.
#
# These two values are SAFE to ship to the browser: the publishable key is
# sent with every request a visitor makes, and it is Row Level Security —
# not secrecy — that protects the data behind it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# The service_role key is NOT listed here on purpose. It bypasses Row Level
# Security completely. It belongs only in Supabase Edge Function secrets,
# where Supabase injects it automatically — never in this file, never in the
# client bundle, never in git.
